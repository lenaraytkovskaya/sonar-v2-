# Copy to .env on the server. Never commit real values.

# --- Postgres (one instance, two databases) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/sonar
REGISTRY_DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/registry

# --- App ---
# Random session encryption secret, at least 32 characters.
AUTH_SECRET=
APP_URL=https://sonar.cryid.com
MONTHLY_BUDGET_USD=50

# --- Providers ---
GOOGLE_PLACES_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_TOKEN=
RESEND_WEBHOOK_SECRET=
# Telegram application credentials (MTProto); user sessions use AUTH_SECRET.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WAHA_API_KEY=
WAHA_URL=http://waha:3000
# Shared internal Viber Desktop bridge secret. Required before starting viber.
VIBER_BRIDGE_KEY=
VIBER_BRIDGE_URL=http://viber:3000
# Shared key for the persistent social browser service. Blank disables its API safely.
SOCIAL_BROWSER_KEY=
SOCIAL_BROWSER_URL=http://social-browser:3000
# Six-digit Messenger PIN of the Sonar Facebook account. The worker types it once into the
# chat-restore dialog; a rejected PIN is not retried. Blank dismisses the dialog without restoring.
FACEBOOK_RESTORE_PIN=
TWOCAPTCHA_API_KEY=
SONAR_MESSAGING_CAPTCHA_PROVIDER=2captcha
IPROYAL_API_KEY=
# Comma-separated http(s) proxy URLs; credentials remain server-side.
SOCIAL_PROXY_URLS=
