{
  "name": "sonar",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @sonar/db db:generate",
    "db:migrate": "pnpm --filter @sonar/db db:migrate",
    "user:create": "pnpm --filter @sonar/web user:create"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
