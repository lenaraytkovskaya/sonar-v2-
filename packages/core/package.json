{
  "name": "@sonar/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "default": "./dist/telegram.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "default": "./dist/whatsapp.js"
    },
    "./social-session": {
      "types": "./dist/social-session.d.ts",
      "default": "./dist/social-session.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "libphonenumber-js": "^1.13.16",
    "telegram": "^2.26.22",
    "tldts": "^7.4.22",
    "zod": "^4.6.7"
  }
}
