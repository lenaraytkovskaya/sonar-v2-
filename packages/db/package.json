{
  "name": "@sonar/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "default": "./dist/budget.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./campaigns": {
      "types": "./dist/campaigns.d.ts",
      "default": "./dist/campaigns.js"
    },
    "./batches": {
      "types": "./dist/batches.d.ts",
      "default": "./dist/batches.js"
    },
    "./companies": {
      "types": "./dist/companies.d.ts",
      "default": "./dist/companies.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "default": "./dist/analysis.js"
    },
    "./outreach": {
      "types": "./dist/outreach.d.ts",
      "default": "./dist/outreach.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./prozorro": {
      "types": "./dist/prozorro.d.ts",
      "default": "./dist/prozorro.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "default": "./dist/telegram.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "default": "./dist/whatsapp.js"
    },
    "./inbound": {
      "types": "./dist/inbound.d.ts",
      "default": "./dist/inbound.js"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "default": "./dist/social.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@sonar/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11"
  }
}
